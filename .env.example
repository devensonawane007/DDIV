# ============================================================
# DDIV Environment Configuration
# ============================================================

# Execution Mode: mock | baseline | ddiv
DDIV_MODE=mock

# Experiment Name
DDIV_EXPERIMENT=default

# Provider Type: mock | openai_compatible | anthropic | ollama
PROVIDER_TYPE=mock
API_BASE_URL=https://api.together.xyz/v1

# Agent 1 — Locator (Target: Qwen2.5-Coder-7B-Instruct)
LOCATOR_API_KEY=
LOCATOR_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
LOCATOR_TEMPERATURE=0.2
LOCATOR_MAX_TOKENS=2048

# Agent 2 — Coder (Target: Devstral Small 24B)
CODER_API_KEY=
CODER_MODEL=mistralai/Devstral-24B-v0.1
CODER_TEMPERATURE=0.2
CODER_MAX_TOKENS=4096

# Agent 3 — Tester (Target: DeepSeek-Coder-V2)
TESTER_API_KEY=
TESTER_MODEL=deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct
TESTER_TEMPERATURE=0.2
TESTER_MAX_TOKENS=2048

# Agent 4 — Recovery Supervisor (Target: Qwen3-Coder)
SUPERVISOR_API_KEY=
SUPERVISOR_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
SUPERVISOR_TEMPERATURE=0.2
SUPERVISOR_MAX_TOKENS=3072

# Global Execution Parameters
REQUEST_TIMEOUT=60
MAX_RETRIES=3
MAX_RECOVERY_ATTEMPTS=4

# Memory & Trust Configuration
MEMORY_DB_PATH=data/ddiv_memory.db
INIT_TRUST_LOCATOR=0.87
INIT_TRUST_CODER=0.74
INIT_TRUST_TESTER=0.91
INIT_TRUST_SUPERVISOR=0.84

# Safe Execution / Workspace
WORKSPACE_ROOT=data/workspaces
SUBPROCESS_TIMEOUT=120
