          "anchor": "def hermite_normal_form(M, method='default'):",
          "code": "\n# Wrapper to preserve zero rows that may be removed by the original HNF implementation.\n# The original function is renamed to _original_hermite_normal_form and called here.\n_original_hermite_normal_form = hermite_normal_form\n\ndef hermite_normal_form(M, method='default'):\n    \"\"\"Return the Hermite Normal Form of ``M`` while keeping any all\u2011zero rows.\n\n    The underlying SymPy implementation may truncate zero rows based on the\n    computed rank. This wrapper restores the original number of rows by padding\n    with zero rows when necessary.\n    \"\"\"\n    H = _original_hermite_normal_form(M, method=method)\n    # If the result has fewer rows than the input, pad with zero rows at the bottom.\n    if H.shape[0] < M.shape[0]:\n        zero_rows = M.zeros(M.shape[0] - H.shape[0], M.shape[1])\n        H = H.col_join(zero_rows)\n    return H\n",
          "reason": "Ensures hermite_normal_form does not drop zero rows, fixing the row\u2011loss bug when using flips/transposes for row\u2011style HNF."
